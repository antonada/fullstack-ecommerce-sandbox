{
  "name": "fullstack-ecommerce-sandbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node api/src/server.ts",
    "test": "npm test -w tests",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
