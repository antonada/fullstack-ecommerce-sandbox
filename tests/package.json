{
  "name": "@shop/tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:contract": "playwright test --project=contract",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "demo:record": "playwright test --config=playwright.demo.config.ts && bash scripts/make-demo-media.sh"
  },
  "dependencies": {
    "@shop/shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@playwright/test": "^1.65.0",
    "@types/jsonwebtoken": "^9",
    "jsonwebtoken": "^9.0.3"
  }
}
